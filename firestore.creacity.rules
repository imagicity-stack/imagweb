rules_version = '2';

// Rules for the separate Creacity (Tips & Tricks) Firestore database. Like the
// main database, all access goes through the server (Admin SDK), so browsers
// get none. See BLOG_SETUP.md section 8 for how to apply it to that database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
