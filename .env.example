# ============================================================
# Imagicity — environment variables
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NOTHING here should be committed with real values.
# ============================================================

# ---- Firebase Web App (client SDK) ----
# Get these from Firebase Console → Project settings → Your apps → Web app → SDK setup & configuration.
# (Firebase project number: 654267860574)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=654267860574
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (only if you enabled Google Analytics for the web app)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin SDK (server only) ----
# From a service account key: Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key with literal \n escapes, wrapped in double quotes, e.g.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Optional: defaults to <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ---- Firestore database (optional) ----
# Leave blank to use Firestore's "(default)" database. Set this only if you
# created a named database in Firestore. Used by both the Admin and client SDKs.
FIREBASE_DATABASE_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=   # only needed if the browser reads Firestore directly

# ---- Admin access control ----
# Comma-separated list of emails allowed into /admin. The first time one of
# these accounts signs in, it is granted an `admin` custom claim automatically.
ADMIN_EMAILS=imagicityart@gmail.com

# ---- Google Gemini (AI SEO checks & writing assistance) ----
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash; auto-falls back to
# other current models if one is retired)
GEMINI_MODEL=gemini-2.5-flash

# ---- Site ----
# Canonical origin used for SEO tags, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://imagicity.in
