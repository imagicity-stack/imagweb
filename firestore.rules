rules_version = '2';

// Every read and write goes through the server (Admin SDK, which bypasses
// these rules): public pages read posts in getStaticProps and the admin writes
// through /api/admin/*, where HTML is sanitized and fields are allow-listed.
// No browser code talks to Firestore directly, so nothing is open here. That
// also means a leaked or stale admin token cannot write raw HTML into a post or
// read author details straight from the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
